using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using TMPro;
using UnityEngine.SceneManagement;
using Cinemachine;
using UnityEngine.Serialization;

public class GameSession : MonoBehaviour
{
    [Header("Player Controller")]
    [SerializeField] private PlayerController player; // Player Prefab
    [SerializeField] private Transform playerSpawnPoint; // Optional spawn point
    private PlayerController activePlayer;

    [Header("Camera Virtual")]
    [FormerlySerializedAs("camera")]
    [SerializeField] private CinemachineVirtualCamera virtualCamera;

    [Header("Countdown UI")]
    [SerializeField] private TextMeshProUGUI textCountdown;

    private Coroutine countdownCoroutine;
    private AudioSource audioSource;
    private AudioPlayer audioPlayer;
    private int coin;
    private int diamond;

    List<int> listAttempNumber = new List<int>();

    int _attempt = 1;
    [Header("Others")]
    [SerializeField] TextMeshProUGUI TextAttemps;
    [SerializeField] TextMeshProUGUI TextPickupCoin;
    [SerializeField] TextMeshProUGUI TextTimer;

    [Header("Panel Game")]
    [SerializeField] public GameObject PanelGameOver;

    [Header("Panel Game Over")]
    [SerializeField] public TextMeshProUGUI TextLevels;
    [SerializeField] public TextMeshProUGUI TextLevelResult;
    [SerializeField] TextMeshProUGUI TextLevelComplete;

    void Awake()
    {
        if (audioPlayer == null)
            audioPlayer = FindAnyObjectByType<AudioPlayer>();
        if (audioSource == null)
            audioSource = FindAnyObjectByType<AudioSource>();

        int numberGameSession = FindObjectsByType<GameSession>(FindObjectsSortMode.None).Length;
        if (numberGameSession > 1)
        {
            Destroy(gameObject);
        }
        else
        {
            DontDestroyOnLoad(gameObject);
        }
    }

    private void OnEnable()
    {
        SceneManager.sceneLoaded += OnSceneLoaded;
    }

    private void OnDisable()
    {
        SceneManager.sceneLoaded -= OnSceneLoaded;
    }

    private void OnSceneLoaded(Scene scene, LoadSceneMode mode)
    {
        if (scene.name == Loader.Scene.Home.ToString() ||
            scene.name == Loader.Scene.Loading.ToString() ||
            scene.name == Loader.Scene.MenuLevels.ToString())
        {
            return;
        }

        SetupGameplay();
    }

    void Start()
    {
        RandomNumber();

        if (TextAttemps != null)
            TextAttemps.text = "Attempt " + _attempt.ToString();
        else
            Debug.LogWarning("[GameSession] TextAttemps UI is not assigned!");

        if (activePlayer == null)
            SetupGameplay();
    }

    private void SetupGameplay()
    {
        if (audioPlayer == null)
            audioPlayer = FindAnyObjectByType<AudioPlayer>();

        if (audioPlayer == null)
            Debug.LogWarning("[GameSession] AudioPlayer not found in scene!");

        activePlayer = FindAnyObjectByType<PlayerController>();
        if (activePlayer == null)
        {
            if (player != null)
            {
                activePlayer = Instantiate(player, GetSpawnPosition(), Quaternion.identity);
            }
            else
            {
                Debug.LogWarning("[GameSession] Player prefab is not assigned and no Player found in scene!");
            }
        }

        if (virtualCamera == null)
            virtualCamera = FindAnyObjectByType<CinemachineVirtualCamera>();

        if (virtualCamera != null)
        {
            if (activePlayer != null)
                virtualCamera.Follow = activePlayer.transform;
            else
                Debug.LogWarning("[GameSession] Cannot assign camera Follow target: activePlayer is null!");
        }
        else
        {
            Debug.LogWarning("[GameSession] CinemachineVirtualCamera not found in scene!");
        }

        if (countdownCoroutine != null)
            StopCoroutine(countdownCoroutine);

        countdownCoroutine = StartCoroutine(CountdownRoutine());
    }

    private Vector3 GetSpawnPosition()
    {
        if (playerSpawnPoint != null)
            return playerSpawnPoint.position;

        GameObject spawnObj = GameObject.FindWithTag("Respawn") ?? GameObject.Find("SpawnPoint");
        if (spawnObj != null)
            return spawnObj.transform.position;

        return Vector3.zero;
    }

    private void SetPlayerControl(bool isEnabled)
    {
        if (activePlayer == null)
        {
            Debug.LogWarning("[GameSession] Cannot set player control: activePlayer is null!");
            return;
        }

        activePlayer.enabled = isEnabled;

        Rigidbody2D rb = activePlayer.GetComponent<Rigidbody2D>();
        if (rb != null)
            rb.simulated = isEnabled;
        else
            Debug.LogWarning("[GameSession] Rigidbody2D missing on activePlayer!");
    }

    private IEnumerator CountdownRoutine()
    {
        if (audioPlayer != null)
            audioPlayer.StopMusic();

        SetPlayerControl(false);

        if (textCountdown == null)
            Debug.LogWarning("[GameSession] textCountdown UI is not assigned!");

        for (int i = 3; i > 0; i--)
        {
            if (textCountdown != null)
            {
                textCountdown.gameObject.SetActive(true);
                textCountdown.text = i.ToString();
            }
            yield return new WaitForSeconds(1f);
        }

        if (textCountdown != null)
            textCountdown.text = "GO!";

        SetPlayerControl(true);
        PlayLevelAudio();

        yield return new WaitForSeconds(0.5f);

        if (textCountdown != null)
            textCountdown.gameObject.SetActive(false);

        countdownCoroutine = null;
    }

    private void PlayLevelAudio()
    {
        if (audioPlayer == null)
            audioPlayer = FindAnyObjectByType<AudioPlayer>();

        if (audioPlayer != null)
        {
            audioPlayer.PlayLevelMusic(SceneManager.GetActiveScene().name, Loader.SceneSelected);
        }
        else
        {
            Debug.LogWarning("[GameSession] Cannot play level music: AudioPlayer not found!");
        }
    }

    private void RandomNumber()
    {
        for (int i = 1; i < 80; i++)
        {
            int randomNumber = Random.Range(2, 50);
            listAttempNumber.Add(randomNumber);
        }
    }
    public void ProcessPlayerDeath()
    {
        _attempt++;
        TextAttemps.text = "Attempt " + _attempt.ToString();
        switch (Loader.SceneSelected)
        {
            case Loader.Scene.Level1:
                PlayerPrefs.SetInt("attempt_level_1", _attempt);
                break;
            case Loader.Scene.Level2:
                PlayerPrefs.SetInt("attempt_level_2", _attempt);
                break;
        }
        if (listAttempNumber.Contains(_attempt))
        {
            PanelGameOver.SetActive(true);
            TextLevelComplete.enabled = false;
        }
        else
        {
            Invoke("TakeLife", .5f);
        }
    }

    void TakeLife()
    {
        int currentSceneIndex = SceneManager.GetActiveScene().buildIndex;
        SceneManager.LoadScene(currentSceneIndex);
    }
    public void SetDiamond(int diamondToAdd)
    {
        diamond += diamondToAdd;
        if (_attempt < 5)
        {
            diamond += 10;
        }
        GetTotalDiamonds();
    }

    public void AddCoin(int coinsToAdd)
    {
        switch (Loader.SceneSelected)
        {
            case Loader.Scene.Level1:
                coin += coinsToAdd;
                var coinLevel1 = PlayerPrefs.GetInt("coin_level_1", 0);
                PlayerPrefs.SetInt("coin_level_1", coin + coinLevel1);
                break;


            case Loader.Scene.Level2:
                coin += coinsToAdd;
                var coinLevel2 = PlayerPrefs.GetInt("coin_level_2", 0);
                PlayerPrefs.SetInt("coin_level_2", coin + coinLevel2);
                break;
            case Loader.Scene.Level3:
                coin += coinsToAdd;
                var coinLevel3 = PlayerPrefs.GetInt("coin_level_3", 0);
                PlayerPrefs.SetInt("coin_level_3", coin + coinLevel3);
                break;

        }
        TextPickupCoin.text = coin.ToString();
        GetTotalCoins();
    }

    public void GetTotalCoins()
    {
        var totalCoins = PlayerPrefs.GetInt("total_coins", 0);
        PlayerPrefs.SetInt("total_coins", totalCoins + coin);
    }

    public void GetTotalDiamonds()
    {
        var totalDiamonds = PlayerPrefs.GetInt("total_diamonds", 0);
        PlayerPrefs.SetInt("total_diamonds", totalDiamonds + diamond);
    }
    public void ResetGameSession()
    {
        Destroy(gameObject);
    }

    public void ReplayGame()
    {
        if (FinishLine.isFinish)
        {
            ResetGameSession();
        }
        PanelGameOver.SetActive(false);
        int currentSceneIndex = SceneManager.GetActiveScene().buildIndex;
        SceneManager.LoadScene(currentSceneIndex);
    }
    public void BackHome()
    {
        SceneManager.LoadScene("Home");
        Destroy(gameObject);
    }

}
