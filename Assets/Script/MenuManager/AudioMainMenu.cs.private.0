using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Advertisements;
public class AudioMainMenu : MonoBehaviour
{
    AudioSource m_AudioSource;
    void Awake()
    {
        m_AudioSource = GetComponent<AudioSource>();
        int numberScenePersist = FindObjectsByType<AudioMainMenu>(FindObjectsSortMode.None).Length;
        if (numberScenePersist > 1)
        {
            Destroy(gameObject);
        }
        else { DontDestroyOnLoad(gameObject); }
    }
    void Update()
    {
        if (m_AudioSource != null)
        {
            m_AudioSource.mute = Advertisement.isShowing;
        }
    }
    public void ResetAudioMainMenu()
    {
        if (this != null && gameObject != null)
        {
            Destroy(gameObject);
        }
    }
}
